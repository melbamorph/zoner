# Server-side only. Never expose this value in client code or commit a real key.
OPENAI_API_KEY=replace_with_server_side_openai_api_key

# Environment-specific Agent Builder workflow ID.
# This is not an API secret, but it still identifies which workflow the app uses.
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=wf_replace_with_agent_builder_workflow_id

# Optional. Leave unset unless you intentionally need a nonstandard ChatKit API base.
# CHATKIT_API_BASE=https://api.openai.com
